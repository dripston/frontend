# Copy to `.env.local` and fill in. `.env.local` is gitignored; never commit secrets.
# Every variable here must also be declared in `src/env.ts` or it will be ignored.

# ----- Public (inlined into the client bundle — nothing secret) -----
NEXT_PUBLIC_APP_NAME="Hackathon"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ----- Server-only -----
# fatal | error | warn | info | debug | trace
LOG_LEVEL="debug"

# Examples — uncomment here and add to `serverSchema` in src/env.ts:
# DATABASE_URL="postgresql://user:password@localhost:5432/app"
# SESSION_SECRET="generate-with-openssl-rand-base64-32"
