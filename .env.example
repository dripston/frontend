# Copy to `.env.local` and fill in. `.env.local` is gitignored; never commit secrets.
# Every variable here must also be declared in `src/env.ts` or it will be ignored.

# ----- Public (inlined into the client bundle — nothing secret) -----
NEXT_PUBLIC_APP_NAME="Hackathon"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ----- Server-only -----
# fatal | error | warn | info | debug | trace
LOG_LEVEL="debug"

# Neon connection string, from the Neon console (use the pooled URL).
# postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=""

# Signs session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Only needed when the deployed origin differs from NEXT_PUBLIC_APP_URL.
# BETTER_AUTH_URL="https://your-app.example.com"

# ----- Optional OAuth providers -----
# Providers are registered only when both values are present.
# GitHub callback:  {APP_URL}/api/auth/callback/github
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# Google callback:  {APP_URL}/api/auth/callback/google
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ----- Background jobs (Upstash QStash) -----
QSTASH_URL="https://qstash.upstash.io"
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# Verifi benchmarking service (FastAPI in `ai service/ai-marketplace/benchmarking-1`).
BENCHMARK_API_URL="http://127.0.0.1:8000"
